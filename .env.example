# Required for every /api route. Without it they answer 503.
GOOGLE_API_KEY=your-google-api-key

# Optional: seed new stores (and enable /sync) from a Notion database.
# Leave both empty to create plain empty stores.
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Optional overrides (defaults shown).
DEFAULT_MODEL=gemini-3-flash-preview
DEFAULT_STORE_DISPLAY_NAME=my-file-search-store
UPLOAD_POLL_INTERVAL_SECONDS=5
UPLOAD_TIMEOUT_SECONDS=300
CORS_ORIGINS=*
